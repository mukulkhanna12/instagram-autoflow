# ─────────────────────────────────────────────
#  App
# ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret-here   # run: openssl rand -base64 32

# ─────────────────────────────────────────────
#  Database  (free: https://neon.tech)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ─────────────────────────────────────────────
#  Login  (email-OTP — only this address can sign in)
#  Codes are emailed via Resend (free tier: https://resend.com).
#  EMAIL_FROM is optional; without a verified domain, Resend can send from
#  onboarding@resend.dev to your own Resend account email.
# ─────────────────────────────────────────────
ALLOWED_LOGIN_EMAIL=you@example.com
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=AutoFlow <onboarding@resend.dev>

# ─────────────────────────────────────────────
#  Meta / Instagram  (https://developers.facebook.com)
#  Valid OAuth redirect URI: {NEXTAUTH_URL}/api/instagram/callback
# ─────────────────────────────────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=your-random-verify-token   # any string you choose

# ─────────────────────────────────────────────
#  Cron  (protects /api/cron/* — Vercel sends this as a Bearer token)
#  Set the same value in Vercel project settings. openssl rand -base64 32
# ─────────────────────────────────────────────
CRON_SECRET=your-random-cron-secret

# ─────────────────────────────────────────────
#  Public (exposed to browser)
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
