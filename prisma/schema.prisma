generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per person who has ever asked for a login code. Signing up is open —
// anyone can register — but the row starts unapproved, and an unapproved row is
// never emailed a code and can never sign in. Approval is manual: flip
// `isApproved` in the database. Each approved user is a fully separate tenant:
// their Instagram accounts, flows and automations all hang off this row and are
// only ever queried by `userId`.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Manual gate. False for every new signup; set it true by hand to let them in.
  isApproved    Boolean   @default(false)
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  igAccounts InstagramAccount[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One-time login codes for the email-OTP sign-in. A code is hashed (never stored
// in the clear), expires quickly, and is rate-limited per email. `attempts` caps
// how many wrong guesses a single code tolerates before it is thrown away.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model InstagramAccount {
  id              String   @id @default(cuid())
  userId          String
  instagramId     String   @unique
  username        String
  profilePicUrl   String?
  accessToken     String   @db.Text
  pageId          String?
  pageName        String?
  pageAccessToken String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Soft delete. Disconnecting sets this instead of removing the row, so every
  // automation, queued flow and conversation survives a disconnect/reconnect
  // cycle. Reconnecting the same instagramId clears it and everything reappears.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  automations PostAutomation[]
  queuedFlows QueuedFlow[]
  reelDefaults ReelDefaults?
}

// A flow prepared in advance for a reel you haven't uploaded yet.
//
// These form an ordered queue per account. When a new reel appears, the flow at
// the front is copied onto it and **deleted** — used up. Upload a reel with an
// empty queue and it simply gets no automation. That's the whole point: each
// prepared flow belongs to one upcoming reel, rather than a single default
// blanketing every reel forever.
//
// Same message fields as PostAutomation, so what gets attached is a faithful copy.
model QueuedFlow {
  id          String @id @default(cuid())
  igAccountId String
  // Front of the queue is the lowest position; ties break on createdAt so the
  // order is always total. Gaps are fine — consuming just deletes a row.
  position    Int    @default(0)
  // Optional label so a queue of several is tellable apart in the UI.
  name        String @default("")

  // Optional comment filter. Comma-separated; empty means respond to every
  // comment. When set, a comment must contain at least one of these words
  // (case-insensitive) before anything is replied or DM'd.
  keywords String @default("") @db.Text

  // Comment reply, plus up to two optional variants. A random non-empty one is
  // posted each time so replies don't look automated (spam-safe).
  commentReplyText   String  @default("Sent you a DM! 📩") @db.Text
  commentReplyText2  String? @default("Just DM'd you the details 🙌") @db.Text
  commentReplyText3  String? @default("It's in your inbox now ✨") @db.Text
  greetingMessage    String @default("Hey! 👋 Hope you're doing great.\n\nClick the button below to get the details I promised!") @db.Text
  greetingButtonText String @default("Get Details →")
  followMessage      String @default("To receive the details, please follow my page first! 🙏\n\nOnce you follow, click the button below.") @db.Text
  followButtonText   String @default("I've Followed ✓")
  followRetryMessage String @default("Hmm, I can't see you on my followers list yet 👀\n\nPlease follow the page first, then tap the button again.") @db.Text
  detailsMessage     String @default("Here are the details you asked for! 🎉\n\nClick below to visit the page.") @db.Text
  // The final message's buttons are optional — turn them off to send plain text.
  // detailsButtons holds up to 3 link buttons as [{ title, url }] — Instagram's
  // button template allows no more than three. detailsButtonText/detailsUrl are
  // the original single-button fields, kept as a fallback for rows written
  // before detailsButtons existed; see lib/buttons.ts.
  detailsButtonEnabled Boolean @default(true)
  detailsButtons       Json    @default("[]")
  detailsButtonText    String  @default("Visit Page 🔗")
  detailsUrl           String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete, and the record of being used up. A flow leaves the queue when
  // it is consumed into an automation (consumedAt) or removed by hand
  // (isDeleted); either way the row stays so the history is auditable.
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  consumedAt DateTime?

  igAccount InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@index([igAccountId, position])
}

// The wording a brand-new reel automation starts from.
//
// One row per account, edited on the Reels → Default messages page. It is only
// ever read at creation time: a reel that already has an automation has been
// customised by then, and rewriting it from here would be the opposite of a
// default. A prepared flow in the queue still wins over these — it was written
// for that specific reel.
model ReelDefaults {
  id          String @id @default(cuid())
  igAccountId String @unique

  keywords String @default("") @db.Text

  commentReplyText   String  @default("Sent you a DM! 📩") @db.Text
  commentReplyText2  String? @default("Just DM'd you the details 🙌") @db.Text
  commentReplyText3  String? @default("It's in your inbox now ✨") @db.Text
  greetingMessage    String @default("Hey! 👋 Hope you're doing great.\n\nClick the button below to get the details I promised!") @db.Text
  greetingButtonText String @default("Get Details →")
  followMessage      String @default("To receive the details, please follow my page first! 🙏\n\nOnce you follow, click the button below.") @db.Text
  followButtonText   String @default("I've Followed ✓")
  followRetryMessage String @default("Hmm, I can't see you on my followers list yet 👀\n\nPlease follow the page first, then tap the button again.") @db.Text
  detailsMessage     String @default("Here are the details you asked for! 🎉\n\nClick below to visit the page.") @db.Text
  detailsButtonEnabled Boolean @default(true)
  detailsButtons       Json    @default("[]")
  detailsButtonText    String  @default("Visit Page 🔗")
  detailsUrl           String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  igAccount InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
}

model PostAutomation {
  id            String  @id @default(cuid())
  igAccountId   String
  postId        String
  postUrl       String?
  postCaption   String? @db.Text
  postThumbnail String?
  isActive      Boolean @default(false)

  // Soft delete. Deleting an automation from the dashboard sets this; the row
  // and all its Conversation history stay. Configuring the same reel again
  // revives this row rather than creating a second one — see @@unique below.
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  // True when this automation was created automatically from the account's
  // default template (a reel uploaded after the template was enabled).
  fromTemplate  Boolean @default(false)
  // When the reel's pre-existing comments were last swept for a catch-up run.
  // Null means never — which is what triggers the automatic sweep the first
  // time the reel is switched Live. See lib/backfill.ts.
  backfilledAt  DateTime?

  // Per-step analytics counters, incremented as the flow runs. "Sent" counts
  // successful DM sends; "Clicked" counts button taps (a postback from the user).
  // These power the ManyChat-style Sent / Clicked / CTR figures in the editor.
  commentsHandled Int @default(0) // public comment replies posted
  greetingSent    Int @default(0)
  greetingClicked Int @default(0)
  followSent      Int @default(0)
  followClicked   Int @default(0)
  detailsSent     Int @default(0) // final message delivered
  // New follows attributable to this reel: people who were gated as "not
  // following", then went and followed and came back to a passing check.
  followsGained   Int @default(0)

  // Optional comment filter. Comma-separated; empty means respond to every
  // comment. When set, a comment must contain at least one of these words
  // (case-insensitive) before anything is replied or DM'd.
  keywords String @default("") @db.Text

  // Comment reply, plus up to two optional variants. A random non-empty one is
  // posted each time so replies don't look automated (spam-safe).
  commentReplyText   String  @default("Sent you a DM! 📩") @db.Text
  commentReplyText2  String? @default("Just DM'd you the details 🙌") @db.Text
  commentReplyText3  String? @default("It's in your inbox now ✨") @db.Text
  greetingMessage    String @default("Hey! 👋 Hope you're doing great.\n\nClick the button below to get the details I promised!") @db.Text
  greetingButtonText String @default("Get Details →")
  followMessage      String @default("To receive the details, please follow my page first! 🙏\n\nOnce you follow, click the button below.") @db.Text
  followButtonText   String @default("I've Followed ✓")
  // Sent when they tap "I've followed" but still are not following. Loops until they do.
  followRetryMessage String @default("Hmm, I can't see you on my followers list yet 👀\n\nPlease follow the page first, then tap the button again.") @db.Text
  detailsMessage     String @default("Here are the details you asked for! 🎉\n\nClick below to visit the page.") @db.Text
  // The final message's buttons are optional — turn them off to send plain text.
  // detailsButtons holds up to 3 link buttons as [{ title, url }] — Instagram's
  // button template allows no more than three. detailsButtonText/detailsUrl are
  // the original single-button fields, kept as a fallback for rows written
  // before detailsButtons existed; see lib/buttons.ts.
  detailsButtonEnabled Boolean @default(true)
  detailsButtons       Json    @default("[]")
  detailsButtonText    String  @default("Visit Page 🔗")
  detailsUrl           String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  igAccount     InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([igAccountId, postId])
}

model Conversation {
  id           String   @id @default(cuid())
  automationId String
  igUserId     String
  igUsername   String?
  state        String   @default("greeted")
  commentId    String?
  // Last DM send failure for this person, surfaced in the flow editor so a
  // silent delivery problem (expired token, permission gap) is visible.
  lastError    String?   @db.Text
  lastErrorAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  automation PostAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, igUserId])
  @@index([igUserId])
}
